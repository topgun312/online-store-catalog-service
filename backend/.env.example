# backend (.env.example — скопируй в .env и подправь под себя)

MODE=DEV
LOG_TO_FILE=false
LOG_FILE=logs.json

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=catalog_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# MinIO (S3)
S3_ENDPOINT_URL=http://localhost:9000
# внешний адрес MinIO для presigned-ссылок (если отличается от внутреннего,
# например http://localhost:9000 внутри docker и http://minio.local:9000 снаружи)
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=catalog-images
S3_REGION=us-east-1

# presign | proxy — как отдавать картинки фронту
IMAGE_URL_MODE=presign
# абсолютный базовый URL этого api (нужен в proxy-режиме)
PUBLIC_BASE_URL=http://localhost:8000
IMAGE_URL_TTL_SEC=3600

# валидация загружаемых изображений
MAX_IMAGE_SIZE_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
