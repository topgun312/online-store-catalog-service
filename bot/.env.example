# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AA...your-bot-token

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=111111111,222222222

# Backend API base url
BACKEND_URL=http://localhost:8000

# Redis url for shared FSM storage (redis://host:port/db)
REDIS_URL=redis://localhost:6379/0

# Public HTTPS url of the catalog frontend (Telegram Mini App)
WEBAPP_URL=https://catalog.example.com

# Public HTTPS url for Telegram webhook updates (without /webhook)
WEBHOOK_URL=https://bot.example.com

# Secret token for X-Telegram-Bot-Api-Secret-Token (passed to setWebhook by bot-init)
WEBHOOK_SECRET=your-webhook-secret

# Register or delete webhook automatically (compose sets false for replicas)
SET_WEBHOOK_ON_STARTUP=true
DELETE_WEBHOOK_ON_SHUTDOWN=false

# Write logs to a local file in addition to stdout (disabled in Docker)
LOG_TO_FILE=false
